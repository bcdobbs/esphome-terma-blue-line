# Copy this file to secrets.yaml and fill in your own values.
# secrets.yaml is gitignored — never commit real credentials.

# Wi-Fi the ESP32 joins
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Fallback access point (used if Wi-Fi is unavailable)
ap_password: "a-fallback-ap-password"

# Home Assistant API encryption key (generate one at https://esphome.io/components/api)
api_encryption_key: "base64-32-byte-key=="

# Password for over-the-air firmware updates
ota_password: "an-ota-password"

# Your Terma radiator's BLE MAC address
# Find it in the Terma app, with nRF Connect, or from the esp32_ble_tracker logs.
radiator_mac: "XX:XX:XX:XX:XX:XX"
