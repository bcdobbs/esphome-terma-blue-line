# ESPHome build artifacts
.esphome/

# Secrets — never commit real credentials or your radiator's MAC
secrets.yaml

# Maintainer's personal local-dev entry file (uses local components + !include)
dev.yaml

# Local BLE snoops / logs (may contain your MAC + local network info)
logs/

# OS cruft
.DS_Store

# Python bytecode (created when ESPHome loads the component)
__pycache__/
