# Copy this file to secrets.yaml and fill in your own values.
# secrets.yaml is gitignored - never commit real credentials.
# In ESPHome Builder, paste these into Secrets (top right) instead.
#
# Device-prefixed names, because ESPHome Builder shares one secrets file between all
# devices. The API key also secures OTA updates, so there's no OTA password.

# Wi-Fi the ESP32 joins (2.4 GHz - the ESP32 has no 5 GHz radio)
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# The radiator's Bluetooth MAC: on a label on the element, or see README
# "Finding your radiator's MAC".
terma_moa_blue__radiator_mac: "XX:XX:XX:XX:XX:XX"

# Home Assistant API encryption key. ESPHome Builder generates one for each new
# device, or generate one at https://esphome.io/components/api
terma_moa_blue__api_encryption_key: "base64-32-byte-key=="
