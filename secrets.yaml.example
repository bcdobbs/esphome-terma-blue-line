# Copy this file to secrets.yaml and fill in your own values.
# secrets.yaml is gitignored - never commit real credentials.
# In ESPHome Builder, paste the lines you need into Secrets (top right) instead.
#
# Delete the section you don't use.

# --- Every config -------------------------------------------------------------
# Wi-Fi the ESP32 joins (2.4 GHz - the ESP32 has no 5 GHz radio)
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# --- examples/m5stack-atoms3-lite.yaml and -on-demand.yaml ----------------------
# Device-prefixed names, because ESPHome Builder shares one secrets file between
# all devices. The API key also secures OTA updates, so there's no OTA password.
terma_moa_blue__radiator_mac: "XX:XX:XX:XX:XX:XX"
terma_moa_blue__api_encryption_key: "base64-32-byte-key=="

# --- terma-moa-blue.example.yaml ------------------------------------------------
radiator_mac: "XX:XX:XX:XX:XX:XX"
api_encryption_key: "base64-32-byte-key=="
ota_password: "an-ota-password"
ap_password: "a-fallback-ap-password"   # for the fallback hotspot if Wi-Fi fails

# Radiator MAC: on a label on the element, or see README "Finding your radiator's MAC".
# API key: ESPHome Builder generates one for each new device, or generate one at
# https://esphome.io/components/api
